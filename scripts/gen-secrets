#!/usr/bin/env python3
"""Generate the secrets Gouvra needs and append the missing ones to .env.

Never overwrites an existing value. Safe to run several times.

    scripts/gen-secrets            # writes to ./.env
    scripts/gen-secrets --print    # prints fresh values without touching any file
    scripts/gen-secrets --rotate-encryption-key
                                   # prepends a new key to ENCRYPTION_KEYS (see docs/operations.md)
"""

from __future__ import annotations

import argparse
import base64
import os
import secrets
import sys
from datetime import UTC, datetime
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent


def b64key(nbytes: int = 32) -> str:
    return base64.urlsafe_b64encode(secrets.token_bytes(nbytes)).decode().rstrip("=")


def new_kid() -> str:
    return "k" + datetime.now(UTC).strftime("%Y%m%d%H%M%S")


def fresh_values() -> dict[str, str]:
    return {
        "SESSION_SECRET": secrets.token_urlsafe(48),
        "ENCRYPTION_KEYS": f"{new_kid()}:{b64key()}",
        "POSTGRES_PASSWORD": secrets.token_urlsafe(24),
        "VALKEY_PASSWORD": secrets.token_urlsafe(24),
        "SANDBOX_TOKEN": secrets.token_urlsafe(32),
    }


def read_env(path: Path) -> dict[str, str]:
    values: dict[str, str] = {}
    if not path.exists():
        return values
    for line in path.read_text(encoding="utf-8").splitlines():
        stripped = line.strip()
        if not stripped or stripped.startswith("#") or "=" not in stripped:
            continue
        key, _, value = stripped.partition("=")
        values[key.strip()] = value.strip()
    return values


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawTextHelpFormatter)
    parser.add_argument("--env-file", default=str(ROOT / ".env"))
    parser.add_argument("--print", action="store_true", help="print values, do not write")
    parser.add_argument("--rotate-encryption-key", action="store_true")
    args = parser.parse_args()

    if args.print:
        for key, value in fresh_values().items():
            sys.stdout.write(f"{key}={value}\n")
        return 0

    path = Path(args.env_file)
    existing = read_env(path)

    if args.rotate_encryption_key:
        current = existing.get("ENCRYPTION_KEYS", "")
        if not current:
            sys.stderr.write("ENCRYPTION_KEYS is empty: run without --rotate-encryption-key first\n")
            return 1
        rotated = f"{new_kid()}:{b64key()},{current}"
        lines = path.read_text(encoding="utf-8").splitlines()
        lines = [f"ENCRYPTION_KEYS={rotated}" if line.startswith("ENCRYPTION_KEYS=") else line for line in lines]
        path.write_text("\n".join(lines) + "\n", encoding="utf-8")
        sys.stdout.write("New encryption key prepended. Restart api + worker, then run "
                         "`gouvra rotate-secrets` to re-encrypt stored secrets.\n")
        return 0

    missing = {k: v for k, v in fresh_values().items() if not existing.get(k)}
    if not missing:
        sys.stdout.write("All generated secrets already present — nothing to do.\n")
        return 0
    block = ["", f"# --- generated by scripts/gen-secrets on {datetime.now(UTC):%Y-%m-%d} ---"]
    block += [f"{k}={v}" for k, v in missing.items()]
    with path.open("a", encoding="utf-8") as fh:
        fh.write("\n".join(block) + "\n")
    os.chmod(path, 0o600)
    sys.stdout.write(f"Added {', '.join(missing)} to {path}\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
