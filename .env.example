# =====================================================================
# Gouvra — environment configuration
# Copy to `.env`, fill in what you need, then run `scripts/gen-secrets`
# to generate every internal secret. Never commit `.env`.
# =====================================================================

# ---------------------------------------------------------------------
# Generated by scripts/gen-secrets (do not invent these by hand)
# ---------------------------------------------------------------------
# Signs CSRF and OAuth-state cookies. >= 32 random bytes.
SESSION_SECRET=
# Encryption key ring for secrets at rest (provider keys, tool credentials):
# "kid:base64url-32-bytes[,older-kid:key...]". The first key encrypts; all keys decrypt.
# Rotation: scripts/gen-secrets --rotate-encryption-key, then `gouvra rotate-secrets`.
ENCRYPTION_KEYS=
POSTGRES_PASSWORD=
VALKEY_PASSWORD=
# Shared token between the worker and the sandbox service.
SANDBOX_TOKEN=
# Password of the demo account (demo@gouvra.dev) created at first start. Local use only.
DEMO_PASSWORD=

# ---------------------------------------------------------------------
# Public URLs
# ---------------------------------------------------------------------
# Web app (links in e-mails, post-login redirects, Origin checks)
APP_URL=http://localhost:8080
# API as reached by browsers for OAuth callbacks. Dev: the API port itself.
# Production: same as APP_URL (Caddy serves /api on the app's origin).
API_PUBLIC_URL=http://localhost:8000

# ---------------------------------------------------------------------
# E-mail — EMAIL_PROVIDER: smtp (Mailpit in dev) | resend | console
# ---------------------------------------------------------------------
EMAIL_PROVIDER=smtp
# Resend (https://resend.com) — required when EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Sender, e.g. "Gouvra <noreply@your-verified-domain.com>"
EMAIL_FROM=
# SMTP relay — when EMAIL_PROVIDER=smtp outside the local stack (which uses Mailpit).
# SMTP_SECURITY: starttls (port 587) | ssl (port 465) | none (local relay only; refused in production)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=starttls

# ---------------------------------------------------------------------
# Model providers — used by tests and the demo seed only.
# In the product, each workspace stores its own (encrypted) keys in Providers.
# ---------------------------------------------------------------------
DEEPSEEK_API_KEY=
# Optional: enables the real-API contract test of the Anthropic adapter.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------
# OAuth sign-in (optional — a provider's button is hidden when its pair is missing).
# Callback URLs to declare with the provider:
#   GitHub: {API_PUBLIC_URL}/api/v1/auth/oauth/github/callback
#   Google: {API_PUBLIC_URL}/api/v1/auth/oauth/google/callback
# (dev: http://localhost:8000/api/v1/auth/oauth/github/callback, …/google/callback)
# ---------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------
# Billing (SaaS) — BILLING_PROVIDER: none (self-hosted) | simulated | stripe
# ---------------------------------------------------------------------
BILLING_PROVIDER=none
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Obtained with: stripe listen --api-key $STRIPE_SECRET_KEY --print-secret
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------
# Policy & limits (defaults are sensible; uncomment to change)
# ---------------------------------------------------------------------
# SIGNUP_ENABLED=true
# MAX_REQUEST_BODY_BYTES=1048576
# DEFAULT_EXECUTION_TIMEOUT_S=120
# MAX_EXECUTION_TIMEOUT_S=900
# DEFAULT_WORKSPACE_CONCURRENCY=5
# WORKER_CONCURRENCY=16
# LOG_LEVEL=INFO

# ---------------------------------------------------------------------
# Production only (docker-compose.prod.yml) — see docs/operations.md
# ---------------------------------------------------------------------
# Public host name served by Caddy with an automatic HTTPS certificate
DOMAIN=
# Contact for certificate notices (Let's Encrypt / ZeroSSL)
ACME_EMAIL=
# Published ports (defaults 80 / 443)
HTTP_PORT=
HTTPS_PORT=
# Image tag built or pulled for the api, worker and web services
GOUVRA_VERSION=
